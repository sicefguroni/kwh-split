project     = "kwh-split"
environment = "dev"
aws_region  = "ap-southeast-1"

# Optional: same as `export AWS_PROFILE=...` but stored in tfvars (do not commit real tfvars if it contains secrets).
# aws_profile = "your-aws-cli-profile-name"

# Required: set a strong password for RDS (must match what RDS was created with, or reset in console)
db_password = "change-me-in-production"

# Required: min 32 characters (openssl rand -base64 48)
jwt_secret = "change-me-use-openssl-rand-base64-48"

# ECR tags you pushed (build API + worker images with the same tag)
api_image_tag    = "migrate"
worker_image_tag = "migrate"

# Public SPA on CloudFront (S3 + /api/* → ALB)
enable_public_site = true

# Custom domain (optional) — requires a Route 53 hosted zone for the domain
# site_domain       = "app.example.com"
# route53_zone_id   = "Z0123456789ABCDEFGHIJ"   # Route 53 → Hosted zones → your zone → ID
# site_domain_aliases = ["www.example.com"]       # optional extra names on the same cert + CDN

# Google Cloud Console → OAuth 2.0 Web client (same app as local server/.env)
# google_client_id     = ""
# google_client_secret = ""

# TabScanner receipt OCR (copy from server/.env)
# ocr_api_key = ""

# SES "From" address for outbound email (SES handles delivery via IAM roles)
# smtp_from   = "Split <noreply@yourdomain.com>"
