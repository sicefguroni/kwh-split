{
  "name": "kwh-split",
  "version": "0.1.0",
  "private": true,
  "description": "Split — a simplified and transparent group expense tracker",
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "start": "pnpm -r --parallel --stream run start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:migrate": "pnpm --filter @split/server run db:migrate",
    "deploy:site": "bash infra/scripts/deploy-site.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "flag": "^5.0.1",
    "nodemailer": "^8.0.7"
  }
}
