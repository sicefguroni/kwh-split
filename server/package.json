{
  "name": "@split/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build:server": "tsc -p tsconfig.json",
    "build:lambdas": "esbuild src/lambdas/debt-reminders.ts src/lambdas/weekly-summary.ts --bundle --platform=node --target=node22 --outdir=dist/lambdas --format=cjs --out-extension:.js=.cjs",
    "build": "pnpm build:server && pnpm build:lambdas",
    "start": "node dist/index.js",
    "start:worker": "node dist/notification-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1047.0",
    "@aws-sdk/client-sns": "^3.1047.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jose": "^6.0.6",
    "multer": "^2.1.1",
    "pg": "^8.13.3",
    "pg-connection-string": "^2.12.0",
    "pino": "^9.6.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^5.0.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.8.1",
    "ws": "^8.18.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.1"
  }
}
