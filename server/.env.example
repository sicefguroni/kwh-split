# Server
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
OAUTH_CALLBACK_BASE_URL=http://localhost:4000

# Auth
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Social OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database — use either DATABASE_URL or the DATABASE_* block (not both required; see pool.ts).
# RDS passwords with @, [, ], etc. often break URI parsing: omit DATABASE_URL and use DATABASE_* instead.
DATABASE_URL=postgres://Ceferinochloe1234@localhost:5432/kwh_split
# DATABASE_HOST=your-db.region.rds.amazonaws.com
# DATABASE_PORT=5432
# DATABASE_USER=split
# DATABASE_PASSWORD=your-raw-password
# DATABASE_NAME=split
# DATABASE_SSL=true   # required for AWS RDS; auto-enabled when DATABASE_HOST is *.rds.amazonaws.com

# Redis (optional locally; required for notification worker + cluster rate limits + WS fan-out in prod)
# REDIS_URL=redis://localhost:6379

# Receipt OCR (TabScanner — https://tabscanner.com)
# OCR_API_KEY=

# SMTP (group invitation emails). Port 587 = STARTTLS, 465 = SSL.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Split <noreply@example.com>

# Offline sync (POST /api/sync): optional default group when payload omits group_id
# OFFLINE_SYNC_DEFAULT_GROUP_ID=1
