# Server
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Database
# Set DATABASE_HOST/DATABASE_PORT etc for production RDS
# Use .env.development.local for local dev with local Postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSL=false

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SES)
SMTP_FROM=

# OCR
OCR_API_KEY=
